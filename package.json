{
  "name": "@ureck/alexandria",
  "version": "1.6.0",
  "description": "Alexandria — bóveda de conocimiento local para agentes de IA (Claude Code, Codex, Gemini CLI, Cursor, OpenCode y más): captura automática por hooks, búsqueda semántica offline y grafo estilo Obsidian. Ahorra tokens inyectando solo el contexto relevante.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ale": "dist/cli.js",
    "alexandria": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "release:public": "node scripts/release-public.mjs"
  },
  "keywords": [
    "claude-code",
    "knowledge-base",
    "obsidian",
    "semantic-search",
    "mcp",
    "embeddings",
    "local-first",
    "codex",
    "gemini-cli",
    "cursor",
    "opencode",
    "hooks",
    "ai-memory",
    "agents-md",
    "pdf",
    "docx",
    "xlsx",
    "document-reading",
    "token-optimization"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.13.0",
    "minisearch": "^7.1.2",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "jszip": "^3.10.2",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "author": "Ureck <urielgomezbecerril@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UreckChan/alexandria.git"
  },
  "homepage": "https://alexandria.ureck.dev",
  "bugs": {
    "url": "https://github.com/UreckChan/alexandria/issues"
  }
}
